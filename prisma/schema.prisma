datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  createdAt        DateTime          @default(now())
  workspaceMembers WorkspaceMember[]
  approvals        Approval[]
  auditEvents      AuditEvent[]
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  members   WorkspaceMember[]
  projects  Project[]
  createdAt DateTime          @default(now())
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    // "ADMIN" | "DEVELOPER" | "VIEWER"
  createdAt   DateTime  @default(now())
}

model Project {
  id            String         @id @default(uuid())
  name          String
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments  Environment[]
  agents        Agent[]
  testSuites    TestSuite[]
  ingestionKeys IngestionKey[]
  createdAt     DateTime       @default(now())
}

model Environment {
  id          String       @id @default(uuid())
  name        String       // "PRODUCTION" | "STAGING" | "DEVELOPMENT"
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  traces      Trace[]
  deployments Deployment[]
  releases    Release[]
  createdAt   DateTime     @default(now())
}

model Agent {
  id        String         @id @default(uuid())
  name      String
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  AgentVersion[]
  traces    Trace[]
  testSuites TestSuite[]
  createdAt DateTime       @default(now())
}

model AgentVersion {
  id             String          @id @default(uuid())
  version        String
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  promptSchema   String          // JSON schema representing prompt inputs
  createdAt      DateTime        @default(now())
  traces         Trace[]
  deployments    Deployment[]
  releases       Release[]
  promptVersions PromptVersion[]
  toolVersions   ToolVersion[]
}

model IngestionKey {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyPrefix   String    // Plaintext prefix for quick lookup (e.g. "le_live_")
  hashedKey   String    @unique // SHA-256 hash of plaintext key
  scope       String    // "INGEST" | "READ" | "ADMIN"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
}

model Trace {
  id             String             @id @default(uuid())
  sessionId      String
  agentId        String
  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersionId String
  agentVersion   AgentVersion       @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  userInput      String
  finalOutput    String?
  status         String             // "SUCCESS" | "FAILED" | "RUNNING"
  totalCost      Float              @default(0.0)
  totalLatencyMs Int                @default(0)
  createdAt      DateTime           @default(now())
  steps          TraceStep[]
  browserSessions BrowserSession[]
  failures       Failure[]
  replayResults  ReplayResult[]
  testCases      TestCase[]
  incidentId     String?
  incident       Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model TraceStep {
  id          String   @id @default(uuid())
  traceId     String
  trace       Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  parentId    String?
  name        String   // "MODEL_CALL" | "TOOL_CALL" | "REASONING" | "RETRIEVE"
  status      String   // "SUCCESS" | "ERROR"
  input       String   // JSON input payload
  output      String   // JSON output payload
  latencyMs   Int      @default(0)
  cost        Float    @default(0.0)
  createdAt   DateTime @default(now())
}

model BrowserSession {
  id             String          @id @default(uuid())
  traceId        String
  trace          Trace           @relation(fields: [traceId], references: [id], onDelete: Cascade)
  browserVersion String
  viewportWidth  Int
  viewportHeight Int
  userAgent      String
  createdAt      DateTime        @default(now())
  actions        BrowserAction[]
  snapshots      PageSnapshot[]
  networkLogs    NetworkExchange[]
  artifacts      TraceArtifact[]
}

model BrowserAction {
  id               String         @id @default(uuid())
  browserSessionId String
  session          BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)
  actionType       String         // "CLICK" | "TYPE" | "NAVIGATE" | "SUBMIT"
  selector         String?
  coordinatesX     Int?
  coordinatesY     Int?
  inputValue       String?        // Redacted input text
  url              String?
  timestamp        DateTime       @default(now())
}

model PageSnapshot {
  id               String         @id @default(uuid())
  browserSessionId String
  session          BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)
  url              String
  domContent       String         // Compressed or raw DOM HTML
  accessibilityTree String        // JSON string of accessibility tree
  screenshotPath   String?        // Local or S3 path to PNG
  timestamp        DateTime       @default(now())
}

model NetworkExchange {
  id               String         @id @default(uuid())
  browserSessionId String
  session          BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)
  url              String
  method           String         // "GET" | "POST" etc
  requestHeaders   String         // JSON string (redacted)
  requestBody      String?        // Redacted payload
  responseHeaders  String         // JSON string (redacted)
  responseBody     String?        // Redacted payload
  statusCode       Int
  latencyMs        Int            @default(0)
  timestamp        DateTime       @default(now())
}

model TraceArtifact {
  id               String         @id @default(uuid())
  browserSessionId String
  session          BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)
  name             String
  mimeType         String
  filePath         String
  createdAt        DateTime       @default(now())
}

model Failure {
  id          String   @id @default(uuid())
  traceId     String
  trace       Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  failureType String   // e.g. "FAT-B1" (Broken Selector)
  firstBadStep String   // ID of step/action where deviation began
  diagnosis   String   // Root cause text
  evidence    String   // JSON describing the specific selector/network mismatch
  createdAt   DateTime @default(now())
}

model ReplayJob {
  id            String         @id @default(uuid())
  replayMode    String         // "FIXTURE" | "COUNTERFACTUAL" | "MOCKED" | "LIVE"
  status        String         // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED"
  createdAt     DateTime       @default(now())
  results       ReplayResult[]
}

model ReplayResult {
  id             String    @id @default(uuid())
  replayJobId    String
  replayJob      ReplayJob @relation(fields: [replayJobId], references: [id], onDelete: Cascade)
  traceId        String
  trace          Trace     @relation(fields: [traceId], references: [id], onDelete: Cascade)
  status         String    // "SUCCESS" | "FAILED"
  mismatchDetail String?   // JSON description of action/network mismatches
  createdAt      DateTime  @default(now())
}

model TestSuite {
  id        String     @id @default(uuid())
  name      String
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  experiments Experiment[]
  createdAt DateTime   @default(now())
}

model TestCase {
  id            String            @id @default(uuid())
  testSuiteId   String
  testSuite     TestSuite         @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  sourceTraceId String?
  sourceTrace   Trace?            @relation(fields: [sourceTraceId], references: [id])
  userInput     String
  initialState  String            // JSON state representing system variables
  maxSteps      Int               @default(10)
  maxCost       Float             @default(5.0)
  maxLatencyMs  Int               @default(30000)
  versions      TestCaseVersion[]
  createdAt     DateTime          @default(now())
}

model TestCaseVersion {
  id             String            @id @default(uuid())
  testCaseId     String
  testCase       TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  version        String
  toolMocks      String            // JSON mocked tool responses
  networkMocks   String            // JSON HTTP mock responses (HAR matching rules)
  requiredTools  String            // JSON array of strings
  forbiddenTools String            // JSON array of strings
  expectedState  String?           // JSON assertions
  createdAt      DateTime          @default(now())
  results        ExperimentResult[]
}

model Experiment {
  id          String             @id @default(uuid())
  name        String
  testSuiteId String
  testSuite   TestSuite          @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  runs        ExperimentRun[]
  createdAt   DateTime           @default(now())
}

model ExperimentRun {
  id             String             @id @default(uuid())
  experimentId   String
  experiment     Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantPrompt  String?            // Prompt payload under test
  variantModel   String?            // Model variant under test
  status         String             // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED"
  createdAt      DateTime           @default(now())
  results        ExperimentResult[]
  releaseGates   ReleaseGateResult[]
}

model ExperimentResult {
  id                String          @id @default(uuid())
  experimentRunId   String
  experimentRun     ExperimentRun   @relation(fields: [experimentRunId], references: [id], onDelete: Cascade)
  testCaseVersionId String
  testCaseVersion   TestCaseVersion @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)
  passed            Boolean
  stepsExecuted     Int
  latencyMs         Int
  cost              Float
  errorDetails      String?
  createdAt         DateTime        @default(now())
}

model ReleaseGateResult {
  id              String        @id @default(uuid())
  experimentRunId String
  experimentRun   ExperimentRun @relation(fields: [experimentRunId], references: [id], onDelete: Cascade)
  gateName        String        // e.g. "MAX_LATENCY", "SAFETY_CHECK"
  passed          Boolean
  observedValue   String
  thresholdValue  String
  createdAt       DateTime      @default(now())
  releases        Release[]
}

model Approval {
  id           String    @id @default(uuid())
  approvedById String
  approvedBy   User      @relation(fields: [approvedById], references: [id])
  status       String    // "APPROVED" | "REJECTED"
  notes        String?
  releases     Release[]
  createdAt    DateTime  @default(now())
}

model Release {
  id                  String              @id @default(uuid())
  version             String
  agentVersionId      String
  agentVersion        AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  environmentId       String
  environment         Environment         @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  releaseGateResultId String
  releaseGateResult   ReleaseGateResult   @relation(fields: [releaseGateResultId], references: [id])
  approvalId          String?
  approval            Approval?           @relation(fields: [approvalId], references: [id])
  status              String              // "CANARY" | "PRODUCTION" | "ROLLED_BACK"
  trafficPercent      Int                 @default(0)
  rollbackReason      String?
  createdAt           DateTime            @default(now())
  deployments         Deployment[]
  canaryObservations  CanaryObservation[]
}

model Deployment {
  id             String       @id @default(uuid())
  agentVersionId String
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  releaseId      String?
  release        Release?     @relation(fields: [releaseId], references: [id])
  status         String       // "ACTIVE" | "INACTIVE"
  createdAt      DateTime     @default(now())
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorId     String?  // References User.id or system actor string
  actorType   String   // "USER" | "SYSTEM" | "CI"
  action      String   // e.g. "INGEST_KEYS_REVOKE", "RELEASE_PROMOTE"
  description String
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model Prompt {
  id        String          @id @default(uuid())
  name      String
  versions  PromptVersion[]
  createdAt DateTime        @default(now())
}

model PromptVersion {
  id             String        @id @default(uuid())
  promptId       String
  prompt         Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  version        String
  content        String
  agentVersionId String?
  agentVersion   AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
}

model Tool {
  id        String        @id @default(uuid())
  name      String
  versions  ToolVersion[]
  createdAt DateTime      @default(now())
}

model ToolVersion {
  id             String        @id @default(uuid())
  toolId         String
  tool           Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  version        String
  schema         String        // JSON schema representing tool inputs
  agentVersionId String?
  agentVersion   AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
}

model Incident {
  id            String          @id @default(uuid())
  title         String
  severity      String          // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  status        String          // "OPEN" | "INVESTIGATING" | "RESOLVED"
  firstOccurred DateTime        @default(now())
  lastOccurred  DateTime        @default(now())
  rootCause     String?
  mitigation    String?
  traces        Trace[]
  events        IncidentEvent[]
  createdAt     DateTime        @default(now())
}

model IncidentEvent {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  description String
  createdAt   DateTime @default(now())
}

model CanaryObservation {
  id         String   @id @default(uuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  errorRate  Float    @default(0.0)
  avgCost    Float    @default(0.0)
  avgLatency Int      @default(0)
  createdAt  DateTime @default(now())
}
