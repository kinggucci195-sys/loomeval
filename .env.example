# LoomEval Environment Variables Configuration

# Database Configuration
# Default is SQLite for local zero-dependency quickstart
DATABASE_URL="file:./dev.db"

# LLM Providers Configuration (Optional for mocked test cases, required for counterfactual replays)
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# LoomEval App Configurations
NODE_ENV="development"
PORT=3000
